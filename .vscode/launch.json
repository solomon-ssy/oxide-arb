{
    // Cursor / VS Code Run and Debug — CodeLLDB + cargo build.
    // Log level: RUST_LOG overrides [observability].log_level in config/oxide-arb.toml.
    // When RUST_LOG is unset, the binary uses log_level from config (default: info).
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "oxide-arb (info — config default)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=oxide-arb",
                    "--package=oxide-arb-bin"
                ],
                "filter": {
                    "name": "oxide-arb",
                    "kind": "bin"
                }
            },
            "args": [
                "--config-dir",
                "config"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PATH": "/Users/eason/.cargo/bin:${env:PATH}",
                "OXIDE_ARB_CONFIG_DIR": "config"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "oxide-arb (debug — full RUST_LOG)",
            "cargo": {
                "args": [
                    "build",
                    "--bin=oxide-arb",
                    "--package=oxide-arb-bin"
                ],
                "filter": {
                    "name": "oxide-arb",
                    "kind": "bin"
                }
            },
            "args": [
                "--config-dir",
                "config"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PATH": "/Users/eason/.cargo/bin:${env:PATH}",
                "OXIDE_ARB_CONFIG_DIR": "config",
                "RUST_LOG": "debug"
            }
        },
