{
  // Cursor / VS Code Run and Debug — CodeLLDB + cargo build.
  // Log level: RUST_LOG overrides [observability].log_level in config/quant-pivot.toml.
  // When RUST_LOG is unset, the binary uses log_level from config (default: info).
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "quant-pivot (info — config default)",
      "cargo": {
        "args": ["build", "--bin=quant-pivot", "--package=quant-pivot-bin"],
        "filter": {
          "name": "quant-pivot",
          "kind": "bin"
        }
      },
      "args": [
        "--config-file",
        "${workspaceFolder}/config/quant-pivot.toml",
        "--expected-environment",
        "local-development"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "/Users/eason/.cargo/bin:${env:PATH}"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "quant-pivot (debug — full RUST_LOG)",
      "cargo": {
        "args": ["build", "--bin=quant-pivot", "--package=quant-pivot-bin"],
        "filter": {
          "name": "quant-pivot",
          "kind": "bin"
        }
      },
      "args": [
        "--config-file",
        "${workspaceFolder}/config/quant-pivot.toml",
        "--expected-environment",
        "local-development"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "/Users/eason/.cargo/bin:${env:PATH}",
        "RUST_LOG": "debug"
